# OpenHack Configuration Reference
# Copy this file to .env and update with your values

# =============================================================================
# CORE CONFIGURATION
# =============================================================================

# Application name and domain
OPENHACK_NAME="My Hackathon"
OPENHACK_DOMAIN=hackathon.example.com
OPENHACK_SECRET=your-super-secret-key-min-32-chars-long
TIMEZONE=America/New_York

# Environment
ENVIRONMENT=development  # development, staging, production
LOG_LEVEL=info  # debug, info, warn, error
DEBUG=false

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL (Shared database, separate schemas per service)
DATABASE_URL=postgresql://openhack:openhack_pass@postgres:5432/openhack
POSTGRES_USER=openhack
POSTGRES_PASSWORD=openhack_pass
POSTGRES_DB=openhack
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Database connection pool
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_POOL_TIMEOUT=30000

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================

# Redis (sessions, cache, pub/sub, queues)
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Redis connection pool
REDIS_POOL_MIN=5
REDIS_POOL_MAX=20

# =============================================================================
# AUTH SERVICE CONFIGURATION
# =============================================================================

# JWT Configuration
AUTH_JWT_SECRET=${OPENHACK_SECRET}
AUTH_JWT_EXPIRY=15m
AUTH_REFRESH_TOKEN_EXPIRY=7d
AUTH_JWT_ISSUER=openhack

# Password Policy
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_PASSWORD_REQUIRE_UPPERCASE=true
AUTH_PASSWORD_REQUIRE_LOWERCASE=true
AUTH_PASSWORD_REQUIRE_NUMBERS=true
AUTH_PASSWORD_REQUIRE_SPECIAL=true

# Session Configuration
AUTH_SESSION_TIMEOUT=24h
AUTH_SESSION_COOKIE_SECURE=true
AUTH_SESSION_COOKIE_HTTPONLY=true
AUTH_SESSION_COOKIE_SAMESITE=strict

# Rate Limiting
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=60000

# =============================================================================
# OAUTH PROVIDERS
# =============================================================================

# GitHub OAuth
GITHUB_ENABLED=true
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=${OPENHACK_DOMAIN}/api/auth/oauth/github/callback

# Google OAuth
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=${OPENHACK_DOMAIN}/api/auth/oauth/google/callback

# Discord OAuth
DISCORD_ENABLED=true
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_CALLBACK_URL=${OPENHACK_DOMAIN}/api/auth/oauth/discord/callback

# =============================================================================
# MFA CONFIGURATION
# =============================================================================

# TOTP (Time-based One-Time Password)
MFA_TOTP_ENABLED=true
MFA_TOTP_ISSUER=OpenHack
MFA_TOTP_DIGITS=6
MFA_TOTP_PERIOD=30

# SMS (Twilio)
MFA_SMS_ENABLED=false
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# =============================================================================
# MAIL SERVICE CONFIGURATION
# =============================================================================

# Mail Provider (smtp, sendgrid, ses, mailgun)
MAIL_PROVIDER=smtp
MAIL_FROM=noreply@${OPENHACK_DOMAIN}
MAIL_FROM_NAME=${OPENHACK_NAME}

# SMTP Configuration
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
SMTP_REJECT_UNAUTHORIZED=true

# SendGrid (alternative to SMTP)
SENDGRID_API_KEY=

# AWS SES (alternative to SMTP)
AWS_SES_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Rate Limiting
MAIL_RATE_LIMIT_ENABLED=true
MAIL_RATE_LIMIT_MAX_PER_HOUR=1000

# =============================================================================
# NOTIFICATION SERVICE CONFIGURATION
# =============================================================================

# Discord Bot
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Slack Bot
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Webhook Configuration
WEBHOOK_SECRET=your-webhook-hmac-secret
WEBHOOK_RETRY_COUNT=3
WEBHOOK_TIMEOUT=30000

# =============================================================================
# DISCORD BOT SERVICE CONFIGURATION
# =============================================================================

# Discord Bot Settings
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_ENABLED=true
DISCORD_BOT_LOG_INTERACTIONS=true
DISCORD_BOT_PORT=3011

# =============================================================================
# AI SERVICE CONFIGURATION
# =============================================================================

# AI Provider (openai, anthropic)
# Use "openai" for OpenAI or any OpenAI-compatible endpoint (Ollama, vLLM, LM Studio, etc.)
# Use "anthropic" for Claude
LLM_PROVIDER=openai

# OpenAI / OpenAI-compatible endpoint
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4-turbo
# Set this to your custom endpoint for Ollama, vLLM, LM Studio, etc.
# Examples: http://localhost:11434/v1  http://ollama:11434/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic (alternative)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# AI Features
AI_FEATURE_CHAT=true
AI_FEATURE_IDEA_GENERATOR=true
AI_FEATURE_TEAM_MATCHER=true
AI_FEATURE_CODE_REVIEW=false
AI_FEATURE_ORGANIZER_INSIGHTS=true
FEATURE_BRAND_EXTRACTION=true

# RAG Configuration
AI_RAG_ENABLED=true
AI_RAG_TOP_K=5
AI_EMBEDDING_MODEL=text-embedding-3-small

# =============================================================================
# STORAGE CONFIGURATION
# =============================================================================

# Storage Provider (local, minio, s3, gcs, azure)
STORAGE_PROVIDER=local

# Local Storage
LOCAL_STORAGE_PATH=/var/lib/openhack/media
LOCAL_STORAGE_MAX_SIZE=52428800  # 50MB

# MinIO (S3-compatible)
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=openhack-media
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false

# AWS S3
AWS_REGION=us-east-1
AWS_S3_BUCKET=openhack-media
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_USE_PATH_STYLE=false

# Google Cloud Storage
GCS_BUCKET=
GCS_CREDENTIALS=

# Azure Blob Storage
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_CONTAINER=

# File Upload Limits
MAX_FILE_SIZE=52428800  # 50MB
MAX_IMAGE_SIZE=10485760  # 10MB
MAX_VIDEO_SIZE=524288000  # 500MB

# Allowed File Types
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp
ALLOWED_DOCUMENT_TYPES=application/pdf,application/zip
ALLOWED_VIDEO_TYPES=video/mp4,video/quicktime

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================

# Next.js
# Empty = same-origin (Next.js rewrites proxy to gateway in Docker)
# For local dev without Docker: http://localhost:8000
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=ws://${OPENHACK_DOMAIN}
NEXT_PUBLIC_APP_NAME=${OPENHACK_NAME}

# Feature Flags
NEXT_PUBLIC_FEATURE_TEAMS=true
NEXT_PUBLIC_FEATURE_PROJECTS=true
NEXT_PUBLIC_FEATURE_JUDGING=true
NEXT_PUBLIC_FEATURE_VOTING=true
NEXT_PUBLIC_FEATURE_SPONSORS=true
NEXT_PUBLIC_FEATURE_AI=${AI_ENABLED}

# =============================================================================
# GATEWAY CONFIGURATION
# =============================================================================

# API Gateway (gateway-rust — built-in reverse proxy + SSE)
GATEWAY_URL=http://gateway-svc:8000
CORS_ORIGIN=*

# Rate limits are built into gateway-rust. Override upstream URLs if needed:
# ROUTES_OVERRIDE=/api/auth=http://auth-svc:3001;/api/core=http://core-svc:3002

# CORS
CORS_ENABLED=true
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_CREDENTIALS=true
CORS_MAX_AGE=3600

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================

# Prometheus
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_ENABLED=false
GRAFANA_ADMIN_PASSWORD=

# Alertmanager
ALERTMANAGER_ENABLED=false

# Tracing (OpenTelemetry)
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAME=openhack

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================

# Backup Schedule (cron format)
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM

# Backup Retention
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=12

# Backup Destination
BACKUP_DESTINATION=/backups
BACKUP_S3_BUCKET=openhack-backups
BACKUP_S3_REGION=us-east-1

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# HTTPS/TLS
HTTPS_ENABLED=true
TLS_CERT_PATH=/etc/ssl/certs/openhack.crt
TLS_KEY_PATH=/etc/ssl/private/openhack.key

# Security Headers
SECURITY_HSTS_ENABLED=true
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_FRAME_OPTIONS=DENY
SECURITY_CONTENT_TYPE_NOSNIFF=true

# CSP (Content Security Policy)
CSP_ENABLED=true
CSP_DEFAULT_SRC="'self'"
CSP_SCRIPT_SRC="'self' 'unsafe-inline'"
CSP_STYLE_SRC="'self' 'unsafe-inline'"

# =============================================================================
# MULTI-TENANCY (Optional)
# =============================================================================

MULTI_TENANCY_ENABLED=false
TENANCY_MODEL=schema  # schema or database
DEFAULT_TENANT=default

# =============================================================================
# DEVELOPMENT ONLY
# =============================================================================

# Hot Reload
DEV_HOT_RELOAD=true
DEV_WATCH_FILES=true

# Debug Tools
DEV_ENABLE_PROFILING=false
DEV_ENABLE_QUERY_LOGGING=true
DEV_ENABLE_SWAGGER=true

# Test Data
DEV_SEED_DATA=false
DEV_TEST_USERS=false

# =============================================================================
# DEPLOYMENT SPECIFIC
# =============================================================================

# Kubernetes
KUBERNETES_ENABLED=false
KUBERNETES_NAMESPACE=openhack

# Docker Compose
DOCKER_COMPOSE_PROJECT_NAME=openhack

# Health Check
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10

# =============================================================================
# END OF CONFIGURATION
# =============================================================================
