{
  "annotations": { "list": [] },
  "title": "OpenHack Database",
  "description": "PostgreSQL performance metrics: connections, queries, cache hit rate, replication, and resource usage",
  "tags": ["openhack", "database", "postgresql"],
  "timezone": "utc",
  "schemaVersion": 16,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Database Connections",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(pg_stat_activity_count{state=\"active\"})",
          "legendFormat": "Active",
          "refId": "A"
        },
        {
          "expr": "sum(pg_stat_activity_count{state=\"idle\"})",
          "legendFormat": "Idle",
          "refId": "B"
        },
        {
          "expr": "sum(pg_stat_activity_count{state=\"idle in transaction\"})",
          "legendFormat": "Idle in Transaction",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 2,
      "title": "Query Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "rate(pg_stat_statements_calls_total[5m])",
          "legendFormat": "Queries/sec",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "QPS"
        }
      }
    },
    {
      "id": 3,
      "title": "Query Latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "pg_stat_statements_mean_exec_seconds",
          "legendFormat": "Mean Execution Time",
          "refId": "A"
        },
        {
          "expr": "pg_stat_statements_mean_plan_seconds",
          "legendFormat": "Mean Plan Time",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 4,
      "title": "Slow Queries (>1s)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(pg_stat_statements{mean_exec_seconds>1})",
          "legendFormat": "Slow Queries",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Cache Hit Rate",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "pg_stat_database_blks_hit / (pg_stat_database_blks_hit + pg_stat_database_blks_read) * 100",
          "legendFormat": "Cache Hit Rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "yellow", "value": 80 },
              { "color": "green", "value": 95 }
            ]
          },
          "max": 100
        }
      }
    },
    {
      "id": 6,
      "title": "Table Sizes (Top 10)",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "topk(10, pg_relation_size_bytes)",
          "legendFormat": "{{relname}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "id": 7,
      "title": "Replication Lag",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "pg_replication_lag_seconds",
          "legendFormat": "Lag",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 8,
      "title": "Dead Tuples",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 24 },
      "targets": [
        {
          "expr": "sum(pg_stat_user_tables_n_dead_tup)",
          "legendFormat": "Dead Tuples",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 9,
      "title": "Database Size",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 24 },
      "targets": [
        {
          "expr": "pg_database_size_bytes{datname=\"openhack\"}",
          "legendFormat": "Size",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "id": 10,
      "title": "PostgreSQL Exporter Health",
      "type": "stat",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 30 },
      "targets": [
        {
          "expr": "pg_up",
          "legendFormat": "pg_up (1=healthy)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "green", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 11,
      "title": "Pod Resource Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 36 },
      "targets": [
        {
          "expr": "container_memory_working_set_bytes{container=\"postgres\", pod=~\"postgres.*\"}",
          "legendFormat": "Memory - {{pod}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "id": 12,
      "title": "Postgres CPU Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 36 },
      "targets": [
        {
          "expr": "rate(container_cpu_usage_seconds_total{container=\"postgres\", pod=~\"postgres.*\"}[5m])",
          "legendFormat": "CPU - {{pod}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores"
        }
      }
    }
  ]
}
